VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (console.cloud.google.com) — must match server/.env's
# GOOGLE_CLIENT_ID. Public value, safe to expose client-side.
VITE_GOOGLE_CLIENT_ID=

# Wompi public key is safe to expose client-side (that's its purpose) — used to
# tokenize card data directly from the browser, so raw card numbers never hit our server.
VITE_WOMPI_PUBLIC_KEY=
VITE_WOMPI_ENV=sandbox
