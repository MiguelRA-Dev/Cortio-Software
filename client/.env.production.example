# Used by `npm run build` when building for deployment (single-App-Service setup —
# see server/DEPLOY.md). Vite layers this over .env automatically for production
# builds. Copy to .env.production and fill in before building.

# Relative path — the API is served from the same origin as the built frontend
# (server.js serves both), so no domain needs to be hardcoded here.
VITE_API_URL=/api

# Same value as client/.env, but for the real production Google OAuth client.
VITE_GOOGLE_CLIENT_ID=
