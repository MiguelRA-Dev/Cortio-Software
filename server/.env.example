PORT=5000
MONGODB_URI=
JWT_SECRET=

# Public URL of the frontend (used to build links inside emails, e.g. verification)
APP_URL=http://localhost:5173

# Resend (https://resend.com) — for verification emails
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth Client ID (console.cloud.google.com) — used to verify "Sign in with
# Google" credentials from the client. Same value goes in client/.env as
# VITE_GOOGLE_CLIENT_ID. Not a secret (it's the public audience of the token).
GOOGLE_CLIENT_ID=

# MercadoPago (https://www.mercadopago.com.co/developers/panel/app) — test credentials
# while testing, production ones once the integration is approved. Each billing period is
# a one-time Checkout Pro payment link (POST /checkout/preferences), not a recurring
# subscription — MercadoPago's Suscripciones/Preapproval product doesn't support Colombian
# debit cards for the recurring authorization, which most target customers only have.
# MERCADOPAGO_WEBHOOK_SECRET is the "Clave secreta" from the app's Webhooks configuration
# (event type "Pagos"), not the Access Token.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Monthly subscription price in COP (whole pesos, no decimals — e.g. 79000)
SUBSCRIPTION_PRICE_COP=
# Annual subscription price in COP — a separate one-time Checkout Pro link that extends
# currentPeriodEnd by 365 days instead of 1 month (see billingController.startCheckout)
SUBSCRIPTION_PRICE_ANNUAL_COP=

# WhatsApp Business Platform (Meta Graph API) — sends appointment notifications to
# barbers/professionals. WHATSAPP_ACCESS_TOKEN is a permanent System User token from
# Business Settings > Users > System users (permissions: whatsapp_business_messaging,
# whatsapp_business_management). WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_BUSINESS_ACCOUNT_ID
# come from WhatsApp Manager > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Azure Application Insights — captures server-side exceptions/requests in production so
# failures don't go unnoticed. Get the value from the "cortiosoftware" Application
# Insights resource (Azure Portal > Overview > Connection String). Left empty in local
# dev on purpose — server.js only starts the SDK when this is set.
APPLICATIONINSIGHTS_CONNECTION_STRING=
