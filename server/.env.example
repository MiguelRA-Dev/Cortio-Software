PORT=5000
MONGODB_URI=
JWT_SECRET=

# Public URL of the frontend (used to build links inside emails, e.g. verification)
APP_URL=http://localhost:5173

# Resend (https://resend.com) — for verification emails
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth Client ID (console.cloud.google.com) — used to verify "Sign in with
# Google" credentials from the client. Same value goes in client/.env as
# VITE_GOOGLE_CLIENT_ID. Not a secret (it's the public audience of the token).
GOOGLE_CLIENT_ID=

# MercadoPago (https://www.mercadopago.com.co/developers/panel/app) — test credentials
# while testing, production ones once the integration is approved. The app never calls
# POST /preapproval directly (that endpoint 500s on MercadoPago's side regardless of
# payload, confirmed against both a real and a sandbox account) — instead it sends owners
# to the hosted checkout for a single MERCADOPAGO_PLAN_ID, created once via
# POST /preapproval_plan (see server/DEPLOY.md). MERCADOPAGO_WEBHOOK_SECRET is the "Clave
# secreta" from the app's Webhooks configuration, not the Access Token.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PLAN_ID=
MERCADOPAGO_WEBHOOK_SECRET=

# Monthly subscription price in COP (whole pesos, no decimals — e.g. 79000)
SUBSCRIPTION_PRICE_COP=
